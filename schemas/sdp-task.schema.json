{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdp.dev/schemas/sdp-task.schema.json",
  "title": "SDP Task",
  "type": "object",
  "required": ["task_id", "goal", "required_scale", "context", "created_at"],
  "additionalProperties": false,
  "properties": {
    "task_id": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "required_scale": {
      "type": "string",
      "enum": ["Macro", "Meso", "Micro", "Pico", "Collapse"]
    },
    "context": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
