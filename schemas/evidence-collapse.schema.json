{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdp.dev/schemas/evidence-collapse.schema.json",
  "title": "SDP Evidence Collapse Run",
  "type": "object",
  "required": ["task", "current_scale", "hypotheses"],
  "additionalProperties": false,
  "properties": {
    "task": { "$ref": "./sdp-task.schema.json" },
    "current_scale": {
      "type": "string",
      "enum": ["Macro", "Meso", "Micro", "Pico", "Collapse"]
    },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "prior", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "prior": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["evidence_id", "source", "claim", "confidence", "scale"],
              "additionalProperties": false,
              "properties": {
                "evidence_id": { "type": "string", "minLength": 1 },
                "source": { "type": "string", "minLength": 1 },
                "claim": { "type": "string", "minLength": 1 },
                "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
                "scale": {
                  "type": "string",
                  "enum": ["Macro", "Meso", "Micro", "Pico", "Collapse"]
                }
              }
            }
          }
        }
      }
    }
  }
}
